# Pick ONE provider and put its key here, or provide multiple.
# Use LLM_PROVIDER to force a specific one. Otherwise the first available is used.

# LLM_PROVIDER=anthropic | openai | groq | gemini

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (GPT)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq (fast open-weight hosting)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash-latest

# Azure Speech — Pronunciation Assessment (optional, для пофонемного скоринга)
# Free tier F0 = 5 часов/месяц.
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=westeurope

# NextAuth (Wave 3)
# NEXTAUTH_SECRET — сгенерируй: openssl rand -base64 32
# NEXTAUTH_SECRET=...
# NEXTAUTH_URL=http://localhost:3000
# Google OAuth (необязательно — без него работает только email/пароль)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Web Push (VAPID keys, для push-уведомлений). Сгенерировать:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJ...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:teacher@spotlight.local

# Whisper для скоринга произношения через /student/speak
# Используется через GROQ_API_KEY (модель whisper-large-v3-turbo).
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
