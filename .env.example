# Pick ONE provider and put its key here, or provide multiple.
# Use LLM_PROVIDER to force a specific one. Otherwise the first available is used.

# LLM_PROVIDER=anthropic | openai | groq | gemini

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (GPT)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq (fast open-weight hosting)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash-latest

# Azure Speech — Pronunciation Assessment (optional, для пофонемного скоринга)
# Free tier F0 = 5 часов/месяц.
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=westeurope

# ─── ОБЯЗАТЕЛЬНОЕ ─────────────────────────────────────────────────────────
# NextAuth: без NEXTAUTH_SECRET сервер падает с MissingSecret и /api/auth/session
# отдаёт 500, после чего ВСЕ страницы /teacher/* и /student/* ломаются.
# Сгенерируй любую длинную случайную строку:
#   Linux/Mac:  openssl rand -base64 32
#   Windows:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=856932367e87c2f7782f1795f6898c45b8ee590492ad39fa7f8c390f74f62354
NEXTAUTH_URL=http://localhost:3000

# Код регистрации учителя. Без него /api/auth/signup с role=teacher вернёт 403.
# Придумай свой и не публикуй — это пропуск в учительский кабинет.
TEACHER_SIGNUP_CODE=spotlight-teacher-2024

# ─── НЕОБЯЗАТЕЛЬНОЕ ───────────────────────────────────────────────────────
# Google OAuth (без него работает только email/пароль)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Web Push (VAPID keys, для push-уведомлений). Сгенерировать:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJ...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:teacher@spotlight.local

# Whisper для скоринга произношения через /student/speak
# Используется через GROQ_API_KEY (модель whisper-large-v3-turbo).
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
